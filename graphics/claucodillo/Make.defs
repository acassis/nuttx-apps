ifneq ($(CONFIG_GRAPHICS_CLAUCODILLO),)
CONFIGURED_APPS += $(APPDIR)/graphics/claucodillo

# Allows `#include "dlib.h"` (dlib's own convention -- see dlib/dlib.c's
# own #include "dlib.h", a same-directory quoted include) plus a
# from-anywhere path for later packages (lout/dw/src) that need it.
# Also the claucodillo/ top level itself, for d_size.h -- included by
# dlib.h, but the file itself lives one directory up from dlib/.

CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/graphics/claucodillo/claucodillo/dlib
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/graphics/claucodillo/claucodillo

# This package's own hand-maintained config.h (see its own comment) --
# claucodillo/d_size.h's quoted #include "config.h" falls back to this
# once it doesn't find one alongside itself in the claucodillo/ tree.

CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/graphics/claucodillo

endif
