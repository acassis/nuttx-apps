ifneq ($(CONFIG_LIBWEBP),)
CONFIGURED_APPS += $(APPDIR)/graphics/libwebp

# Consumers #include <webp/decode.h> (that header lives at
# libwebp/src/webp/decode.h upstream) -- export libwebp/src. libwebp's
# own internal sources instead #include "src/dec/...", "src/dsp/...",
# "src/utils/..." relative to the libwebp package root, so that needs
# exporting too.
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/graphics/libwebp/libwebp/src
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/graphics/libwebp/libwebp
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/graphics/libwebp/libwebp/src
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/graphics/libwebp/libwebp
endif
